# 复制本文件为 .env 并填入你的密钥（.env 已被 .gitignore 忽略，不会进版本库）
# 兼容 OpenAI 及各类 OpenAI 协议端点（DeepSeek / Moonshot / 通义 / 智谱 等）

OPENAI_API_KEY=sk-xxxx

# 非 OpenAI 官方端点时填写，例如：
#   DeepSeek: https://api.deepseek.com/v1
#   Moonshot: https://api.moonshot.cn/v1
#   OpenAI 官方留空即可
OPENAI_BASE_URL=

# 模型名，例如：gpt-4o-mini / deepseek-chat / moonshot-v1-8k / qwen-plus
OPENAI_MODEL=gpt-4o-mini
