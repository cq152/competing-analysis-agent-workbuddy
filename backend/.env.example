OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-pro

# 飞书自建应用（长连接 Bot 接入层，免公网）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 搜索配置（W2，实际用 ddgs 包，lite backend）=====
SEARCH_ENGINE=ddgs
SEARCH_MAX_RESULTS=5

# ===== 抓取配置（W2）=====
FETCH_TIMEOUT=10
FETCH_MAX_URLS=3
FETCH_MIN_WORD_COUNT=100

# ===== 中文数据源（W2，占位接口，留空则跳过）=====
TIANYANCHA_API_KEY=          # 天眼查开放平台（v3 降为占位，默认不启用）
ENABLE_THIRD_PARTY_API=False # 第三方API开关（小红书/抖音深度数据）
QIMAI_API_KEY=               # 七麦数据

# ===== 监控雷达（v3 核心，提前到 W2）=====
MONITOR_ENABLED=True
MONITOR_INTERVAL_MINUTES=30

# ===== 日志与存储（W2）=====
LOG_LEVEL=INFO
DB_PATH=data/bot.db
